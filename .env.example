# Copy to .env and fill in. Every value has a working default except the keys.
# cp .env.example .env

# ---------- Speech-to-text ----------
# sarvam | elevenlabs | none
STT_PROVIDER=sarvam
SARVAM_API_KEY=
# saarika:v2.5 handles Indic + code-mixed speech; "unknown" auto-detects language
SARVAM_MODEL=saarika:v2.5
SARVAM_LANGUAGE_CODE=unknown

# Alternative provider (set STT_PROVIDER=elevenlabs to use)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v1

# ---------- Answer synthesis (optional) ----------
# Open-weight LLM over an OpenAI-compatible API. Without this the service runs
# the extractive fast path only -- which is what meets the <200ms target anyway.
# Groq: free tier, open-weight models, fast. https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Other options -- only base_url + model change:
#   Groq        openai/gpt-oss-20b | openai/gpt-oss-120b | qwen/qwen3-32b
#   Together    https://api.together.xyz/v1
#   Fireworks   https://api.fireworks.ai/inference/v1
#   Ollama      http://localhost:11434/v1   (fully local, LLM_API_KEY not needed)
#   vLLM        http://localhost:8000/v1    (fully local)

# ---------- Behaviour ----------
# fast     = extractive synthesis, no LLM call, sub-200ms
# grounded = adds the LLM tool-calling loop
DEFAULT_MODE=fast
PIPELINE_BUDGET_MS=200

# ---------- Guardrail thresholds ----------
# Set these from `python scripts/calibrate_guardrails.py` output.
IN_DOMAIN_COSINE_THRESHOLD=0.845
GROUNDEDNESS_THRESHOLD=0.60

# ---------- Serving ----------
HOST=0.0.0.0
PORT=8000
EMBED_THREADS=4
